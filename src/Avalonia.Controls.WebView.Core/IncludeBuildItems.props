<Project>

  <ItemGroup Label="Common Group" Condition="'$(UseAvaloniaFork)' != 'True'">
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- iPlus settings and overrides -->
  <Import Condition="'$(UseAvaloniaFork)' == 'True'" Project="../../iPlus/build/AvaloniaInclude.props" />
  <Import Condition="'$(UseAvaloniaFork)' == 'True' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser'" Project="../../iPlus/build/AvaloniaBaseBrowserInclude.props" />
  <Import Condition="'$(UseAvaloniaFork)' == 'True' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Project="../../iPlus/build/AvaloniaBaseAndroidInclude.props" />
  <!-- End iPlus settings and overrides -->

  <ItemGroup Label="Android Group" Condition="'$(UseAvaloniaFork)' != 'True' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseAvaloniaFork)' != 'True' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser'">
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup Label="Browser Group">
    <!-- See https://github.com/dotnet/sdk/blob/9d4d2c4ca35b0856af7df63d6a38b3259aa6917c/src/StaticWebAssetsSdk/Targets/Microsoft.NET.Sdk.StaticWebAssets.Pack.targets#L64-L66 -->
    <Content Include="$(MSBuildThisFileDirectory)/build/Microsoft.AspNetCore.StaticWebAssets.props">
      <Pack>true</Pack>
      <PackagePath>build/</PackagePath>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)/staticwebassets/**/*.mjs">
      <Pack>true</Pack>
      <PackagePath>staticwebassets/</PackagePath>
    </Content>
  </ItemGroup>

</Project>
